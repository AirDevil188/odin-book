generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("TEST_DATABASE_URL")
}

model User {
  id       String   @id @default(ulid())
  email    String   @unique
  password String
  role     Role     @default(user)
  profile  Profile?

  @@map("users")
}

model Profile {
  id                     String           @id @default(uuid())
  firstName              String           @map("first_name")
  lastName               String           @map("last_name")
  userId                 String           @unique
  avatar                 String?
  comments               Comment[]
  receivedFriendRequests FriendRequests[] @relation("ReceivedRequests")
  sentFriendRequests     FriendRequests[] @relation("SentRequests")
  friendsWith            Friendship[]     @relation("FriendUser")
  friendsOf              Friendship[]     @relation("UserFriend")
  likedComments          LikedComments[]
  likedPosts             LikedPosts[]
  messages               Message[]
  posts                  Post[]           @relation("AuthorPosts")
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats                  Chat[]           @relation("ChatToProfile")
  groups                 GroupMembers[]   @relation("GroupToProfile")

  @@map("profiles")
}

model Friendship {
  id       String  @id @default(uuid())
  friendId String
  userId   String
  friend   Profile @relation("FriendUser", fields: [friendId], references: [userId], onDelete: Cascade)
  user     Profile @relation("UserFriend", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friends")
}

model FriendRequests {
  createdAt   DateTime            @default(now())
  receiverId  String
  requesterId String
  status      FriendRequestStatus @default(pending)
  receiver    Profile             @relation("ReceivedRequests", fields: [receiverId], references: [userId], onDelete: Cascade)
  sender      Profile             @relation("SentRequests", fields: [requesterId], references: [userId], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("friend_requests")
}

model Post {
  id        String       @id @default(ulid())
  text      String
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     Int          @default(0)
  likedBy   LikedPosts[] @relation("PostLikedBy")
  author    Profile      @relation("AuthorPosts", fields: [authorId], references: [userId], onDelete: Cascade)
  comments  Comment[]

  @@map("posts")
}

model LikedPosts {
  userId String
  postId String
  post   Post    @relation("PostLikedBy", fields: [postId], references: [id])
  user   Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("liked_posts")
}

model Comment {
  id        String          @id @default(uuid())
  text      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  authorId  String
  likes     Int             @default(0)
  author    Profile         @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  likedBy   LikedComments[] @relation("CommentLikedBy")
  postId    String
  post      Post            @relation(fields: [postId], references: [id])

  @@map("comments")
}

model LikedComments {
  userId    String
  commentId String
  comment   Comment @relation("CommentLikedBy", fields: [commentId], references: [id])
  user      Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("liked_comments")
}

model Chat {
  id       String    @id @unique @default(uuid())
  messages Message[]
  users    Profile[] @relation("ChatToProfile")

  @@map("chats")
}

model Group {
  id       String         @id @unique @default(uuid())
  name     String
  messages Message[]
  users    GroupMembers[]

  @@map("group")
}

model GroupMembers {
  id      String  @id @default(uuid())
  role    Role    @default(user)
  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    Profile @relation("GroupToProfile", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

model Message {
  id         String   @id @default(uuid())
  text       String
  timestamp  DateTime @default(now())
  chatroomId String?
  groupId    String?
  userId     String
  chats      Chat?    @relation(fields: [chatroomId], references: [id])
  group      Group?   @relation(fields: [groupId], references: [id])
  user       Profile  @relation(fields: [userId], references: [userId])

  @@map("messages")
}

enum Role {
  user
  moderator
  admin
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}
